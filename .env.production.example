DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB?schema=public
JWT_SECRET=change-this-long-random-secret

# Coolify should expose the web service. The frontend talks to the API through Nginx at /api.
VITE_API_URL=/api
WEB_PORT=80

# Optional. Use your public frontend URL if you expose API separately.
WEB_ORIGIN=

# Keep disabled in production unless you are running a controlled developer maintenance window.
ENABLE_DEVELOPER_MAINTENANCE=false

# Optional. Milliseconds the API waits for PostgreSQL before running migrations.
COOLIFY_DB_WAIT_TIMEOUT=60000

# MinIO/S3. Use the internal Docker/Coolify service hostname, not 127.0.0.1.
# If the MinIO service is named "minio" in the same Coolify network, this is http://minio:9000.
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=ACCESS_KEY_DE_MINIO
S3_SECRET_KEY=SECRET_KEY_DE_MINIO
S3_BUCKET=fatboy-file
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
