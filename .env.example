DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fatboy_employee_ledger?schema=public"
JWT_SECRET="change-this-secret"
PORT=3001
VITE_API_URL="http://localhost:3001"
ENABLE_DEVELOPER_MAINTENANCE=false
S3_ENDPOINT="http://minio:9000"
S3_ACCESS_KEY="minio-access-key"
S3_SECRET_KEY="minio-secret-key"
S3_BUCKET="fatboy-file"
S3_REGION="us-east-1"
S3_FORCE_PATH_STYLE=true

# Minutos despues de cerrar turno en los que aun se permiten bebidas, consumos y adelantos (0 = desactivado)
POST_SHIFT_MOVEMENT_WINDOW_MINUTES=120

# Si es true, bebidas/consumos/adelantos exigen turno activo (o cerrado dentro de la ventana anterior). Por defecto false.
REQUIRE_ACTIVE_SHIFT_FOR_MOVEMENTS=false
