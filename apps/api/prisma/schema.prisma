generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMINISTRADOR
  GERENTE
  ENCARGADO
  CAJERO
  EMPLEADO
}

enum MovementKind {
  SALARY_ADVANCE
  LOAN
  INTERNAL_CONSUMPTION
  DRINK
  FOOD
  CASH_OUT
  ADMIN_ADJUSTMENT
  ADMIN_CHARGE
  SHORTAGE_DISCOUNT
  DAMAGE_DISCOUNT
  BALANCE_CORRECTION
  ADMIN_SALARY_ADVANCE
  ADMIN_LOAN
}

enum MovementOrigin {
  EMPLOYEE_REQUEST
  ADMINISTRATIVE_ACTION
}

enum MovementStatus {
  PENDING
  AUTHORIZED
  REJECTED
  CANCELED
  DISCOUNTED
  PARTIALLY_DISCOUNTED
}

enum AuditAction {
  CREATE
  UPDATE
  CANCEL
  STATUS_CHANGE
  LIMIT_CHANGE
  LOGIN
}

model Branch {
  id        String     @id @default(cuid())
  name      String
  code      String     @unique
  active    Boolean    @default(true)
  users     User[]
  employees Employee[]
  movements Movement[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model User {
  id            String     @id @default(cuid())
  fullName      String
  email         String     @unique
  passwordHash  String
  role          Role
  active        Boolean    @default(true)
  branchId      String?
  employeeId    String?    @unique
  branch        Branch?    @relation(fields: [branchId], references: [id])
  employee      Employee?  @relation(fields: [employeeId], references: [id])
  registered    Movement[] @relation("RegisteredBy")
  authorized    Movement[] @relation("AuthorizedBy")
  auditLogs     AuditLog[]
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}

model Employee {
  id           String     @id @default(cuid())
  fullName     String
  pinHash      String
  position     String
  phone        String     @unique
  active       Boolean    @default(true)
  branchId     String
  branch       Branch     @relation(fields: [branchId], references: [id])
  user         User?
  movements    Movement[]
  auditLogs    AuditLog[]  @relation("AffectedEmployee")
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model Movement {
  id              String         @id @default(cuid())
  folio           String         @unique
  employeeId      String
  branchId        String
  kind            MovementKind
  origin          MovementOrigin @default(ADMINISTRATIVE_ACTION)
  amount          Decimal        @db.Decimal(12, 2)
  reason          String
  status          MovementStatus @default(PENDING)
  productName     String?
  quantity        Decimal?       @db.Decimal(12, 3)
  unitPrice       Decimal?       @db.Decimal(12, 2)
  evidenceNote    String?
  receiptText     String
  requestIp       String?
  requestUserAgent String?
  requestDevice   String?
  registeredById  String?
  authorizedById  String?
  employee        Employee       @relation(fields: [employeeId], references: [id])
  branch          Branch         @relation(fields: [branchId], references: [id])
  registeredBy    User?          @relation("RegisteredBy", fields: [registeredById], references: [id])
  authorizedBy    User?          @relation("AuthorizedBy", fields: [authorizedById], references: [id])
  authorizedAt    DateTime?
  canceledAt      DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([employeeId, status])
  @@index([employeeId, origin])
  @@index([branchId, createdAt])
  @@index([kind, status])
}

model AuthorizationRule {
  id           String       @id @default(cuid())
  kind         MovementKind?
  minAmount    Decimal      @db.Decimal(12, 2)
  maxAmount    Decimal?     @db.Decimal(12, 2)
  requiredRole Role
  active       Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model SystemConfig {
  id              String   @id @default(cuid())
  businessName    String   @default("Fatboy Restaurant")
  beveragePrice   Decimal  @default(30.00) @db.Decimal(12, 2)
  receiptLegalText String  @default("Confirmo que solicite y recibi este adelanto, prestamo, consumo o salida de efectivo y acepto los descuentos correspondientes cuando aplique.")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model AuditLog {
  id          String      @id @default(cuid())
  userId      String?
  action      AuditAction
  entity      String
  entityId    String?
  affectedEmployeeId String?
  oldValue    Json?
  newValue    Json?
  ipAddress   String?
  createdAt   DateTime    @default(now())
  user        User?       @relation(fields: [userId], references: [id])
  affectedEmployee Employee? @relation("AffectedEmployee", fields: [affectedEmployeeId], references: [id])

  @@index([entity, entityId])
  @@index([createdAt])
}
