generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMINISTRADOR
  GERENTE
  ENCARGADO
  CAJERO
  EMPLEADO
}

enum MovementKind {
  SALARY_ADVANCE
  LOAN
  INTERNAL_CONSUMPTION
  DRINK
  FOOD
  CASH_OUT
  ADMIN_ADJUSTMENT
  ADMIN_CHARGE
  SHORTAGE_DISCOUNT
  DAMAGE_DISCOUNT
  BALANCE_CORRECTION
  ADMIN_SALARY_ADVANCE
  ADMIN_LOAN
}

enum MovementOrigin {
  EMPLOYEE_REQUEST
  ADMINISTRATIVE_ACTION
}

enum MovementStatus {
  PENDING
  AUTHORIZED
  REJECTED
  CANCELED
  DISCOUNTED
  PARTIALLY_DISCOUNTED
}

enum SalaryType {
  WEEKLY
  BIWEEKLY
  DAILY
}

enum PayrollStatus {
  BORRADOR
  GENERADA
  PAGADA
  CANCELADA
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  CANCEL
  STATUS_CHANGE
  LIMIT_CHANGE
  LOGIN
  BLOCKED
}

enum FileAssetModule {
  INCIDENCIAS
  EMPLEADOS
  CHECKLISTS
  TIMECLOCK
}

enum IncidentStatus {
  REPORTADA
  VISTA
  EN_PROCESO
  RESUELTA
  CERRADA
}

enum TimeClockEventType {
  ENTRY
  EXIT
  BREAK_START
  BREAK_END
}

enum TimeClockEntryStatus {
  VALID
  MANUAL
  VOIDED
}

enum WorkSessionStatus {
  ACTIVE
  CLOSED
  ADJUSTED
}

enum OvertimeAuthorizationStatus {
  PENDING
  AUTHORIZED
  REJECTED
}

enum TimeClockDeviceRequestStatus {
  PENDING
  AUTHORIZED
  REJECTED
  EXPIRED
}

enum TimeClockDeviceType {
  FIXED
  MOBILE
}

model Branch {
  id        String     @id @default(cuid())
  name      String
  code      String     @unique
  active    Boolean    @default(true)
  latitude  Float?
  longitude Float?
  geofenceRadiusMeters Int @default(100)
  users     User[]
  employees Employee[]
  movements Movement[]
  fileAssets FileAsset[]
  incidents Incident[]
  timeClockDevices TimeClockDevice[]
  timeClockDeviceRequests TimeClockDeviceRequest[]
  timeClockEntries TimeClockEntry[]
  workSessions WorkSession[]
  attendanceAdjustments AttendanceAdjustment[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model User {
  id            String     @id @default(cuid())
  fullName      String
  email         String     @unique
  passwordHash  String
  approvalPinHash String?
  role          Role
  active        Boolean    @default(true)
  branchId      String?
  employeeId    String?    @unique
  branch        Branch?    @relation(fields: [branchId], references: [id])
  employee      Employee?  @relation(fields: [employeeId], references: [id])
  registered    Movement[] @relation("RegisteredBy")
  authorized    Movement[] @relation("AuthorizedBy")
  delivered     Movement[] @relation("DeliveredBy")
  generatedPayrolls Payroll[]
  auditLogs     AuditLog[]
  uploadedFiles FileAsset[] @relation("UploadedFiles")
  reportedIncidents Incident[] @relation("IncidentReporter")
  incidentMessages IncidentMessage[] @relation("IncidentMessageAuthor")
  createdTimeClockDevices TimeClockDevice[] @relation("TimeClockDeviceCreator")
  authorizedTimeClockDeviceRequests TimeClockDeviceRequest[] @relation("TimeClockDeviceRequestAuthorizer")
  createdTimeClockEntries TimeClockEntry[] @relation("TimeClockEntryCreator")
  attendanceAdjustments AttendanceAdjustment[] @relation("AttendanceAdjustmentUser")
  overtimeAuthorizations OvertimeAuthorization[] @relation("OvertimeAuthorizationUser")
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}

model Employee {
  id           String     @id @default(cuid())
  fullName     String
  pinHash      String
  position     String
  phone        String     @unique
  active       Boolean    @default(true)
  salaryAmount Decimal    @default(0.00) @db.Decimal(12, 2)
  salaryType   SalaryType @default(WEEKLY)
  hireDate     DateTime?
  branchId     String
  branch       Branch     @relation(fields: [branchId], references: [id])
  user         User?
  movements    Movement[]
  payrollItems PayrollItem[]
  auditLogs    AuditLog[]  @relation("AffectedEmployee")
  incidents    Incident[]
  timeClockEntries TimeClockEntry[]
  workSessions WorkSession[]
  attendanceAdjustments AttendanceAdjustment[]
  workSchedule EmployeeWorkSchedule?
  overtimeAuthorizations OvertimeAuthorization[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model Incident {
  id               String            @id @default(cuid())
  folio            String            @unique
  title            String
  description      String
  status           IncidentStatus    @default(REPORTADA)
  employeeId       String?
  branchId         String
  reportedByUserId String?
  viewedAt         DateTime?
  resolvedAt       DateTime?
  closedAt         DateTime?
  employee         Employee?         @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  branch           Branch            @relation(fields: [branchId], references: [id])
  reportedByUser   User?             @relation("IncidentReporter", fields: [reportedByUserId], references: [id], onDelete: SetNull)
  messages         IncidentMessage[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([status, createdAt])
  @@index([employeeId, createdAt])
  @@index([branchId, createdAt])
  @@index([reportedByUserId, createdAt])
}

model IncidentMessage {
  id         String   @id @default(cuid())
  incidentId String
  authorId   String?
  message    String
  incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  author     User?    @relation("IncidentMessageAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())

  @@index([incidentId, createdAt])
  @@index([authorId, createdAt])
}

model Movement {
  id              String         @id @default(cuid())
  folio           String         @unique
  employeeId      String
  branchId        String
  kind            MovementKind
  origin          MovementOrigin @default(ADMINISTRATIVE_ACTION)
  amount          Decimal        @db.Decimal(12, 2)
  reason          String
  status          MovementStatus @default(PENDING)
  productName     String?
  quantity        Decimal?       @db.Decimal(12, 3)
  unitPrice       Decimal?       @db.Decimal(12, 2)
  evidenceNote    String?
  receiptText     String
  requestIp       String?
  requestUserAgent String?
  requestDevice   String?
  registeredById  String?
  authorizedById  String?
  deliveredById   String?
  employee        Employee       @relation(fields: [employeeId], references: [id])
  branch          Branch         @relation(fields: [branchId], references: [id])
  registeredBy    User?          @relation("RegisteredBy", fields: [registeredById], references: [id])
  authorizedBy    User?          @relation("AuthorizedBy", fields: [authorizedById], references: [id])
  deliveredBy     User?          @relation("DeliveredBy", fields: [deliveredById], references: [id])
  payrollLinks    PayrollItemMovement[]
  authorizedAt    DateTime?
  canceledAt      DateTime?
  deliveredAt     DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([employeeId, status])
  @@index([employeeId, origin])
  @@index([branchId, createdAt])
  @@index([kind, status])
}

model Payroll {
  id                 String                @id @default(cuid())
  periodStart        DateTime
  periodEnd          DateTime
  periodKey          String                @unique
  status             PayrollStatus         @default(GENERADA)
  totalGross         Decimal               @default(0.00) @db.Decimal(12, 2)
  totalDeductions    Decimal               @default(0.00) @db.Decimal(12, 2)
  totalAdjustments   Decimal               @default(0.00) @db.Decimal(12, 2)
  totalNet           Decimal               @default(0.00) @db.Decimal(12, 2)
  generatedByAdminId String
  generatedByAdmin   User                  @relation(fields: [generatedByAdminId], references: [id])
  generatedAt        DateTime              @default(now())
  paidAt             DateTime?
  cancelledAt        DateTime?
  cancelReason       String?
  items              PayrollItem[]
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  @@index([periodStart, periodEnd])
  @@index([status])
}

model PayrollItem {
  id                       String                @id @default(cuid())
  payrollId                String
  employeeId               String
  baseSalary               Decimal               @default(0.00) @db.Decimal(12, 2)
  totalAdvances            Decimal               @default(0.00) @db.Decimal(12, 2)
  totalInternalConsumption Decimal               @default(0.00) @db.Decimal(12, 2)
  totalAdminCharges        Decimal               @default(0.00) @db.Decimal(12, 2)
  totalPenalties           Decimal               @default(0.00) @db.Decimal(12, 2)
  totalPositiveAdjustments Decimal               @default(0.00) @db.Decimal(12, 2)
  totalNegativeAdjustments Decimal               @default(0.00) @db.Decimal(12, 2)
  totalDeductions          Decimal               @default(0.00) @db.Decimal(12, 2)
  netPay                   Decimal               @default(0.00) @db.Decimal(12, 2)
  payroll                  Payroll               @relation(fields: [payrollId], references: [id])
  employee                 Employee              @relation(fields: [employeeId], references: [id])
  movements                PayrollItemMovement[]
  createdAt                DateTime              @default(now())
  updatedAt                DateTime              @updatedAt

  @@unique([payrollId, employeeId])
  @@index([employeeId])
}

model PayrollItemMovement {
  id            String      @id @default(cuid())
  payrollItemId String
  movementId    String
  payrollItem   PayrollItem @relation(fields: [payrollItemId], references: [id])
  movement      Movement    @relation(fields: [movementId], references: [id])
  createdAt     DateTime    @default(now())

  @@unique([movementId])
  @@index([payrollItemId])
}

model AuthorizationRule {
  id           String       @id @default(cuid())
  kind         MovementKind?
  minAmount    Decimal      @db.Decimal(12, 2)
  maxAmount    Decimal?     @db.Decimal(12, 2)
  requiredRole Role
  active       Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model SystemConfig {
  id              String   @id @default(cuid())
  businessName    String   @default("Fatboy Restaurant")
  beveragePrice   Decimal  @default(30.00) @db.Decimal(12, 2)
  receiptLegalText String  @default("Confirmo que solicite y recibi este adelanto, prestamo, consumo o salida de efectivo y acepto los descuentos correspondientes cuando aplique.")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model LoginThrottle {
  id             String    @id @default(cuid())
  scope          String
  identifier     String
  failedAttempts Int       @default(0)
  lockedUntil    DateTime?
  lastFailureAt  DateTime?
  lastFailureIp  String?
  lastUserAgent  String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([scope, identifier])
  @@index([lockedUntil])
  @@index([updatedAt])
}

model AuditLog {
  id          String      @id @default(cuid())
  userId      String?
  action      AuditAction
  entity      String
  entityId    String?
  affectedEmployeeId String?
  oldValue    Json?
  newValue    Json?
  ipAddress   String?
  createdAt   DateTime    @default(now())
  user        User?       @relation(fields: [userId], references: [id])
  affectedEmployee Employee? @relation("AffectedEmployee", fields: [affectedEmployeeId], references: [id])

  @@index([entity, entityId])
  @@index([createdAt])
}

model FileAsset {
  id               String          @id @default(cuid())
  bucket           String
  key              String          @unique
  originalName     String
  mimeType         String
  size             Int
  module           FileAssetModule
  entityId         String?
  branchId         String?
  uploadedByUserId String?
  createdAt        DateTime        @default(now())
  deletedAt        DateTime?
  branch           Branch?         @relation(fields: [branchId], references: [id], onDelete: SetNull)
  uploadedByUser   User?           @relation("UploadedFiles", fields: [uploadedByUserId], references: [id], onDelete: SetNull)
  timeClockEntries TimeClockEntry[] @relation("TimeClockEvidence")

  @@index([module, entityId])
  @@index([branchId, createdAt])
  @@index([uploadedByUserId, createdAt])
  @@index([deletedAt])
}

model TimeClockDevice {
  id          String           @id @default(cuid())
  name        String
  branchId    String
  tokenHash   String           @unique
  tokenLast4  String
  active      Boolean          @default(true)
  createdById String?
  branch      Branch           @relation(fields: [branchId], references: [id])
  createdBy   User?            @relation("TimeClockDeviceCreator", fields: [createdById], references: [id], onDelete: SetNull)
  registrationRequest TimeClockDeviceRequest? @relation("TimeClockDeviceFromRequest")
  entries     TimeClockEntry[]
  sessions    WorkSession[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([branchId, active])
  @@index([createdById])
}

model TimeClockDeviceRequest {
  id                 String                       @id @default(cuid())
  code               String                       @unique
  requestTokenHash   String                       @unique
  requestTokenLast4  String
  status             TimeClockDeviceRequestStatus @default(PENDING)
  branchId           String?
  deviceName         String?
  authorizedDeviceId String?                      @unique
  authorizedById     String?
  requestIp          String?
  requestUserAgent   String?
  expiresAt          DateTime
  branch             Branch?                      @relation(fields: [branchId], references: [id], onDelete: SetNull)
  authorizedDevice   TimeClockDevice?             @relation("TimeClockDeviceFromRequest", fields: [authorizedDeviceId], references: [id], onDelete: SetNull)
  authorizedBy       User?                        @relation("TimeClockDeviceRequestAuthorizer", fields: [authorizedById], references: [id], onDelete: SetNull)
  createdAt          DateTime                     @default(now())
  updatedAt          DateTime                     @updatedAt

  @@index([status, expiresAt])
  @@index([branchId, createdAt])
  @@index([authorizedById, createdAt])
}

model TimeClockEntry {
  id               String               @id @default(cuid())
  employeeId       String
  branchId         String
  deviceId         String?
  deviceType       TimeClockDeviceType  @default(FIXED)
  type             TimeClockEventType
  occurredAt       DateTime
  localDate        String
  localTime        String
  timeZone         String               @default("America/Tijuana")
  evidenceFileId   String?
  latitude         Float?
  longitude        Float?
  accuracy         Float?
  isWithinRadius   Boolean?
  distanceFromBranch Float?
  status           TimeClockEntryStatus @default(VALID)
  notes            String?
  requestIp        String?
  requestUserAgent String?
  createdByUserId  String?
  employee         Employee             @relation(fields: [employeeId], references: [id])
  branch           Branch               @relation(fields: [branchId], references: [id])
  device           TimeClockDevice?     @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  evidenceFile     FileAsset?           @relation("TimeClockEvidence", fields: [evidenceFileId], references: [id], onDelete: SetNull)
  createdByUser    User?                @relation("TimeClockEntryCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  startedSession   WorkSession?         @relation("WorkSessionStartEntry")
  endedSession     WorkSession?         @relation("WorkSessionEndEntry")
  adjustments      AttendanceAdjustment[]
  createdAt        DateTime             @default(now())

  @@index([employeeId, localDate])
  @@index([branchId, localDate])
  @@index([deviceId, createdAt])
  @@index([status, createdAt])
}

model WorkSession {
  id             String            @id @default(cuid())
  employeeId     String
  branchId       String
  deviceId       String?
  startEntryId   String            @unique
  endEntryId     String?           @unique
  startedAt      DateTime
  endedAt        DateTime?
  localDate      String
  timeZone       String            @default("America/Tijuana")
  status         WorkSessionStatus @default(ACTIVE)
  totalMinutes   Int?
  notes          String?
  employee       Employee          @relation(fields: [employeeId], references: [id])
  branch         Branch            @relation(fields: [branchId], references: [id])
  device         TimeClockDevice?  @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  startEntry     TimeClockEntry    @relation("WorkSessionStartEntry", fields: [startEntryId], references: [id])
  endEntry       TimeClockEntry?   @relation("WorkSessionEndEntry", fields: [endEntryId], references: [id])
  adjustments    AttendanceAdjustment[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([employeeId, status])
  @@index([branchId, localDate])
  @@index([startedAt])
}

model AttendanceAdjustment {
  id            String          @id @default(cuid())
  employeeId    String
  branchId      String
  entryId       String?
  workSessionId String?
  action        String
  reason        String
  oldValue      Json?
  newValue      Json?
  adjustedById  String
  ipAddress     String?
  employee      Employee        @relation(fields: [employeeId], references: [id])
  branch        Branch          @relation(fields: [branchId], references: [id])
  entry         TimeClockEntry? @relation(fields: [entryId], references: [id], onDelete: SetNull)
  workSession   WorkSession?    @relation(fields: [workSessionId], references: [id], onDelete: SetNull)
  adjustedBy    User            @relation("AttendanceAdjustmentUser", fields: [adjustedById], references: [id])
  createdAt     DateTime        @default(now())

  @@index([employeeId, createdAt])
  @@index([branchId, createdAt])
  @@index([adjustedById, createdAt])
}

model EmployeeWorkSchedule {
  id                       String   @id @default(cuid())
  employeeId               String   @unique
  mondayEnabled            Boolean  @default(true)
  mondayStart              String   @default("09:00")
  mondayEnd                String   @default("17:00")
  tuesdayEnabled           Boolean  @default(true)
  tuesdayStart             String   @default("09:00")
  tuesdayEnd               String   @default("17:00")
  wednesdayEnabled         Boolean  @default(true)
  wednesdayStart           String   @default("09:00")
  wednesdayEnd             String   @default("17:00")
  thursdayEnabled          Boolean  @default(true)
  thursdayStart            String   @default("09:00")
  thursdayEnd              String   @default("17:00")
  fridayEnabled            Boolean  @default(true)
  fridayStart              String   @default("09:00")
  fridayEnd                String   @default("17:00")
  saturdayEnabled          Boolean  @default(false)
  saturdayStart            String   @default("09:00")
  saturdayEnd              String   @default("17:00")
  sundayEnabled            Boolean  @default(false)
  sundayStart              String   @default("09:00")
  sundayEnd                String   @default("17:00")
  lateGraceMinutes         Int      @default(5)
  overtimeThresholdMinutes Int      @default(15)
  employee                 Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
}

model OvertimeAuthorization {
  id                    String                      @id @default(cuid())
  employeeId            String
  localDate             String
  status                OvertimeAuthorizationStatus @default(PENDING)
  calculatedMinutes     Int
  authorizedMinutes     Int?
  notes                 String?
  authorizedById        String?
  authorizedAt          DateTime?
  employee              Employee                    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  authorizedBy          User?                       @relation("OvertimeAuthorizationUser", fields: [authorizedById], references: [id], onDelete: SetNull)
  createdAt             DateTime                    @default(now())
  updatedAt             DateTime                    @updatedAt

  @@unique([employeeId, localDate])
  @@index([status, localDate])
}
