generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMINISTRADOR
  GERENTE
  ENCARGADO
  CAJERO
  EMPLEADO
}

enum MovementKind {
  SALARY_ADVANCE
  LOAN
  INTERNAL_CONSUMPTION
  DRINK
  FOOD
  CASH_OUT
  ADMIN_ADJUSTMENT
  ADMIN_CHARGE
  SHORTAGE_DISCOUNT
  DAMAGE_DISCOUNT
  BALANCE_CORRECTION
  ADMIN_SALARY_ADVANCE
  ADMIN_LOAN
}

enum MovementOrigin {
  EMPLOYEE_REQUEST
  ADMINISTRATIVE_ACTION
}

enum MovementStatus {
  PENDING
  AUTHORIZED
  REJECTED
  CANCELED
  DISCOUNTED
  PARTIALLY_DISCOUNTED
}

enum SalaryType {
  WEEKLY
  BIWEEKLY
  DAILY
}

enum PayrollStatus {
  BORRADOR
  GENERADA
  PAGADA
  CANCELADA
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  CANCEL
  STATUS_CHANGE
  LIMIT_CHANGE
  LOGIN
}

enum FileAssetModule {
  INCIDENCIAS
  EMPLEADOS
  CHECKLISTS
}

model Branch {
  id        String     @id @default(cuid())
  name      String
  code      String     @unique
  active    Boolean    @default(true)
  users     User[]
  employees Employee[]
  movements Movement[]
  fileAssets FileAsset[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model User {
  id            String     @id @default(cuid())
  fullName      String
  email         String     @unique
  passwordHash  String
  role          Role
  active        Boolean    @default(true)
  branchId      String?
  employeeId    String?    @unique
  branch        Branch?    @relation(fields: [branchId], references: [id])
  employee      Employee?  @relation(fields: [employeeId], references: [id])
  registered    Movement[] @relation("RegisteredBy")
  authorized    Movement[] @relation("AuthorizedBy")
  delivered     Movement[] @relation("DeliveredBy")
  generatedPayrolls Payroll[]
  auditLogs     AuditLog[]
  uploadedFiles FileAsset[] @relation("UploadedFiles")
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}

model Employee {
  id           String     @id @default(cuid())
  fullName     String
  pinHash      String
  position     String
  phone        String     @unique
  active       Boolean    @default(true)
  salaryAmount Decimal    @default(0.00) @db.Decimal(12, 2)
  salaryType   SalaryType @default(WEEKLY)
  hireDate     DateTime?
  branchId     String
  branch       Branch     @relation(fields: [branchId], references: [id])
  user         User?
  movements    Movement[]
  payrollItems PayrollItem[]
  auditLogs    AuditLog[]  @relation("AffectedEmployee")
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model Movement {
  id              String         @id @default(cuid())
  folio           String         @unique
  employeeId      String
  branchId        String
  kind            MovementKind
  origin          MovementOrigin @default(ADMINISTRATIVE_ACTION)
  amount          Decimal        @db.Decimal(12, 2)
  reason          String
  status          MovementStatus @default(PENDING)
  productName     String?
  quantity        Decimal?       @db.Decimal(12, 3)
  unitPrice       Decimal?       @db.Decimal(12, 2)
  evidenceNote    String?
  receiptText     String
  requestIp       String?
  requestUserAgent String?
  requestDevice   String?
  registeredById  String?
  authorizedById  String?
  deliveredById   String?
  employee        Employee       @relation(fields: [employeeId], references: [id])
  branch          Branch         @relation(fields: [branchId], references: [id])
  registeredBy    User?          @relation("RegisteredBy", fields: [registeredById], references: [id])
  authorizedBy    User?          @relation("AuthorizedBy", fields: [authorizedById], references: [id])
  deliveredBy     User?          @relation("DeliveredBy", fields: [deliveredById], references: [id])
  payrollLinks    PayrollItemMovement[]
  authorizedAt    DateTime?
  canceledAt      DateTime?
  deliveredAt     DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([employeeId, status])
  @@index([employeeId, origin])
  @@index([branchId, createdAt])
  @@index([kind, status])
}

model Payroll {
  id                 String                @id @default(cuid())
  periodStart        DateTime
  periodEnd          DateTime
  periodKey          String                @unique
  status             PayrollStatus         @default(GENERADA)
  totalGross         Decimal               @default(0.00) @db.Decimal(12, 2)
  totalDeductions    Decimal               @default(0.00) @db.Decimal(12, 2)
  totalAdjustments   Decimal               @default(0.00) @db.Decimal(12, 2)
  totalNet           Decimal               @default(0.00) @db.Decimal(12, 2)
  generatedByAdminId String
  generatedByAdmin   User                  @relation(fields: [generatedByAdminId], references: [id])
  generatedAt        DateTime              @default(now())
  paidAt             DateTime?
  cancelledAt        DateTime?
  cancelReason       String?
  items              PayrollItem[]
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  @@index([periodStart, periodEnd])
  @@index([status])
}

model PayrollItem {
  id                       String                @id @default(cuid())
  payrollId                String
  employeeId               String
  baseSalary               Decimal               @default(0.00) @db.Decimal(12, 2)
  totalAdvances            Decimal               @default(0.00) @db.Decimal(12, 2)
  totalInternalConsumption Decimal               @default(0.00) @db.Decimal(12, 2)
  totalAdminCharges        Decimal               @default(0.00) @db.Decimal(12, 2)
  totalPenalties           Decimal               @default(0.00) @db.Decimal(12, 2)
  totalPositiveAdjustments Decimal               @default(0.00) @db.Decimal(12, 2)
  totalNegativeAdjustments Decimal               @default(0.00) @db.Decimal(12, 2)
  totalDeductions          Decimal               @default(0.00) @db.Decimal(12, 2)
  netPay                   Decimal               @default(0.00) @db.Decimal(12, 2)
  payroll                  Payroll               @relation(fields: [payrollId], references: [id])
  employee                 Employee              @relation(fields: [employeeId], references: [id])
  movements                PayrollItemMovement[]
  createdAt                DateTime              @default(now())
  updatedAt                DateTime              @updatedAt

  @@unique([payrollId, employeeId])
  @@index([employeeId])
}

model PayrollItemMovement {
  id            String      @id @default(cuid())
  payrollItemId String
  movementId    String
  payrollItem   PayrollItem @relation(fields: [payrollItemId], references: [id])
  movement      Movement    @relation(fields: [movementId], references: [id])
  createdAt     DateTime    @default(now())

  @@unique([movementId])
  @@index([payrollItemId])
}

model AuthorizationRule {
  id           String       @id @default(cuid())
  kind         MovementKind?
  minAmount    Decimal      @db.Decimal(12, 2)
  maxAmount    Decimal?     @db.Decimal(12, 2)
  requiredRole Role
  active       Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model SystemConfig {
  id              String   @id @default(cuid())
  businessName    String   @default("Fatboy Restaurant")
  beveragePrice   Decimal  @default(30.00) @db.Decimal(12, 2)
  receiptLegalText String  @default("Confirmo que solicite y recibi este adelanto, prestamo, consumo o salida de efectivo y acepto los descuentos correspondientes cuando aplique.")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model LoginThrottle {
  id             String    @id @default(cuid())
  scope          String
  identifier     String
  failedAttempts Int       @default(0)
  lockedUntil    DateTime?
  lastFailureAt  DateTime?
  lastFailureIp  String?
  lastUserAgent  String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([scope, identifier])
  @@index([lockedUntil])
  @@index([updatedAt])
}

model AuditLog {
  id          String      @id @default(cuid())
  userId      String?
  action      AuditAction
  entity      String
  entityId    String?
  affectedEmployeeId String?
  oldValue    Json?
  newValue    Json?
  ipAddress   String?
  createdAt   DateTime    @default(now())
  user        User?       @relation(fields: [userId], references: [id])
  affectedEmployee Employee? @relation("AffectedEmployee", fields: [affectedEmployeeId], references: [id])

  @@index([entity, entityId])
  @@index([createdAt])
}

model FileAsset {
  id               String          @id @default(cuid())
  bucket           String
  key              String          @unique
  originalName     String
  mimeType         String
  size             Int
  module           FileAssetModule
  entityId         String?
  branchId         String?
  uploadedByUserId String?
  createdAt        DateTime        @default(now())
  deletedAt        DateTime?
  branch           Branch?         @relation(fields: [branchId], references: [id], onDelete: SetNull)
  uploadedByUser   User?           @relation("UploadedFiles", fields: [uploadedByUserId], references: [id], onDelete: SetNull)

  @@index([module, entityId])
  @@index([branchId, createdAt])
  @@index([uploadedByUserId, createdAt])
  @@index([deletedAt])
}
